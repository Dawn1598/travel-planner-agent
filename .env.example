DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
AMAP_API_KEY=
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
MAX_AGENT_STEPS=20
MAX_REVISIONS=2
# 每轮最多 200 个唯一候选，目标新增 30 篇；旧 XHS_MAX_NOTES 不再使用
XHS_CANDIDATE_LIMIT=200
XHS_TARGET_NEW=30
# 详情导航总次数（含重试）；整轮预算秒数（含质量判断与索引）
XHS_MAX_VISITS=240
XHS_TIME_BUDGET_SECONDS=600
# 每篇首次读取之外的重试次数
XHS_RETRIES=1
XHS_STAGNANT_ROUNDS=3
XHS_REFRESH_HOURS=24
